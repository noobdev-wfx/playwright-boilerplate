# Copy this file to .env and fill in your own Coupa login.
# .env is gitignored; never commit real credentials.

# Coupa sign-in page, e.g. https://<your-instance>.coupacloud.com/sessions/new
COUPA_LOGIN_URL="<your-coupa-login-url>"
COUPA_USERNAME="<your-coupa-username>"
COUPA_PASSWORD="<your-coupa-password>"
